#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${PORT:-/dev/ttyACM0}"
FIRMWARE="bin/ESP32_GENERIC_C6-20260406-v1.28.0.bin"

if [[ ! -f "${FIRMWARE}" ]]; then
    echo "Firmware not found. Run script/setup first." >&2
    exit 1
fi

echo "Erasing flash on ${PORT}..."
.venv/bin/esptool --chip esp32c6 --port "${PORT}" erase-flash

echo "Writing firmware..."
.venv/bin/esptool --chip esp32c6 --port "${PORT}" --baud 460800 write-flash 0x0 "${FIRMWARE}"

echo "Done. Unplug and replug the board, then run script/flash."
